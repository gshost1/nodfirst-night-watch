# Nod First Private Night Watch — environment template
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Inference endpoint (any OpenAI-compatible server) ---
# "mock" = fully offline canned mode (default; also demo insurance if venue Wi-Fi dies).
# On site: sandbox vLLM from the access card, e.g. http://<sandbox-host>:8000/v1
# The DigitalOcean fallback is CONFIG-ONLY: this repo never calls it on its own.
LLM_BASE_URL=mock
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-4B

# --- vLLM Prometheus metrics endpoint ---
# On site: ${VLLM_HOST%/v1}/metrics  (e.g. http://<sandbox-host>:8000/metrics)
# "mock" = synthetic load curve (default; no real vLLM needed)
VLLM_METRICS_URL=mock

# --- Egress guardrail ---
# Hosts allowed to receive PHI-tagged payloads (comma-separated hostnames).
# On site: put the sandbox vLLM host here. PHI never leaves this list.
EGRESS_ALLOWLIST=localhost,127.0.0.1

# --- Non-PHI demo fallback (config-only; surfaced in the dashboard UI, never auto-used) ---
FALLBACK_BASE_URL=https://inference.do-ai.run/v1

# --- Privacy mode ---
# true  = event data is treated as PHI; calls only go to EGRESS_ALLOWLIST hosts.
# false = dev mode; synthetic NON-PHI data in local mock mode.
PHI_MODE=true

# --- App ---
PORT=8765

# --- Mock-only failure knob (development/demo) ---
# 1 = a started Night Watch run fails immediately (run_state "failed", dashboard banner,
# app stays alive). Development/demo facility only; real-endpoint paths never see it.
# Default: 0 (off).
# MOCK_FAIL_RUN=0

# --- Policy threshold overrides (optional; defaults shown) ---
# The agent switches NORMAL / CONSERVE / SURGE from its own vLLM telemetry.
# NORMAL has no thresholds: it is the default when nothing below triggers.
# Leave these commented out to use the documented defaults.
# POLICY_CONSERVE_WAITING=3
# POLICY_CONSERVE_KV=0.70
# POLICY_CONSERVE_TTFT=2.0
# POLICY_SURGE_WAITING=8
# POLICY_SURGE_KV=0.85
# POLICY_SURGE_TTFT=5.0
