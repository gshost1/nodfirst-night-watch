# Nod First Private Night Watch — environment template
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Inference endpoint (any OpenAI-compatible server) ---
# Event demo: sandbox vLLM from the access card, e.g. http://<sandbox-host>:8000/v1
# Dev/validation: https://inference.do-ai.run/v1 (DigitalOcean, NON-PHI synthetic data only)
# "mock" = fully offline canned mode (demo insurance if Wi-Fi dies)
LLM_BASE_URL=mock
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-4B

# --- vLLM Prometheus metrics endpoint ---
# Event demo: ${VLLM_HOST%/v1}/metrics  (e.g. http://<sandbox-host>:8000/metrics)
# "mock" = synthetic load curve (no real vLLM needed)
VLLM_METRICS_URL=mock

# --- Egress guardrail ---
# Hosts allowed to receive PHI-tagged payloads (comma-separated hostnames).
# Tomorrow: put the sandbox vLLM host here. PHI never leaves this list.
EGRESS_ALLOWLIST=localhost,127.0.0.1

# --- Non-PHI demo fallback (flagged in the dashboard UI) ---
FALLBACK_BASE_URL=https://inference.do-ai.run/v1

# --- Privacy mode ---
# true  = event data is treated as PHI; calls only go to EGRESS_ALLOWLIST hosts.
# false = dev mode; synthetic NON-PHI data may go to the configured endpoint.
PHI_MODE=true

# --- App ---
PORT=8765
